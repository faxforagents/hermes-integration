  "license": "MIT",
  "keywords": ["fax", "faxforagents", "mcp", "hermes"],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "faxforagents": {
          "trust": "untrusted"
        }
      }
    }
  }
}
